 / CIERRE)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1603","metadata":{"content":"produccion (VERIFICAR / CIERRE)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1604","metadata":{"content":"roduccion (VERIFICAR / CIERRE)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1605","metadata":{"content":"oduccion (VERIFICAR / CIERRE)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1606","metadata":{"content":"duccion (VERIFICAR / CIERRE)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1607","metadata":{"content":"uccion (VERIFICAR / CIERRE)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1608","metadata":{"content":"ccion (VERIFICAR / CIERRE)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1609","metadata":{"content":"cion (VERIFICAR / CIERRE)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#161","metadata":{"content":"## persiste-de-auditor-refutado (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1610","metadata":{"content":"ion (VERIFICAR / CIERRE)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1611","metadata":{"content":"on (VERIFICAR / CIERRE)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1612","metadata":{"content":"n (VERIFICAR / CIERRE)","okf_concept":"casos-reales.md"