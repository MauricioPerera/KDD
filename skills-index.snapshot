:"casos-reales.md#186","metadata":{"content":"-fallo-no-es-check (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1860","metadata":{"content":"elve-imposible-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1861","metadata":{"content":"lve-imposible-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1862","metadata":{"content":"ve-imposible-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1863","metadata":{"content":"e-imposible-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1864","metadata":{"content":"-imposible-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1865","metadata":{"content":"imposible-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1866","metadata":{"content":"mposible-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1867","metadata":{"content":"posible-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1868","metadata":{"content":"osible-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1869","metadata":{"content":"sible-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#187","metadata":{"content":"fallo-no-es-check (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1870","metadata":{"content":"ible-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1871","metadata":{"content":"ble-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1872","metadata":{"content":"le-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1873","metadata":{"content":"e-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1874","metadata":{"content":"-o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1875","metadata":{"content":"o-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1876","metadata":{"content":"-ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1877","metadata":{"content":"ruidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1878","metadata":{"content":"uidosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1879","metadata":{"content":"idosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#188","metadata":{"content":"allo-no-es-check (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1880","metadata":{"content":"dosa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1881","metadata":{"content":"osa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1882","metadata":{"content":"sa (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1883","metadata":{"content":"a (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1884","metadata":{"content":"(SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1885","metadata":{"content":"(SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1886","metadata":{"content":"SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1887","metadata":{"content":"PEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1888","metadata":{"content":"EC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1889","metadata":{"content":"C)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#189","metadata":{"content":"llo-no-es-check (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1890","metadata":{"content":")","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1891","metadata":{"content":"Una capa de presentación necesitaba que CADA página autenticada mostrara un dato compartido (una lista que vive en la base y cambia en runtime). El modelo de vista que alimentaba ese elemento común era un struct construido a mano en ~20 handlers distintos, y el dato compartido era hasta entonces una constante de paquete. La solución obvia — agregar un campo más y pasarlo en cada handler — habría \"funcionado\" el día uno y fallado en silencio el día que alguien agregara una página nueva y se olvidara: la página renderiza perfecto, sin error, simplemente sin ese elemento.","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1892","metadata":{"content":"erfecto, sin error, simplemente sin ese elemento. En vez de eso se hizo el olvido estructuralmente imposible: el campo nuevo se declaró NO EXPORTADO, de modo que solo el archivo que define el constructor puede llenarlo, y se agregó un test que recorre el paquete y falla si cualquier OTRO archivo construye un literal de ese struct, con un mensaje que nombra la consecuencia exacta (\"...o el dato desaparece en silencio de esa página\"). El orquestador verificó el guardián introduciendo la violación A PROPÓSITO —un archivo nuevo construyendo el struct a mano— y confirmando que el test falla; sin esa prueba, el guardián es una promesa, no una garantía.","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1893","metadata":{"content":"a, el guardián es una promesa, no una garantía. Regla derivada: cuando una invariante depende de que cada sitio de uso futuro \"se acuerde\" de algo, la spec no debe pedir disciplina — debe pedir que el olvido sea imposible (visibilidad del lenguaje, constructor obligatorio) o RUIDOSO (un test que falla). Y el guardián se verifica violándolo a propósito una vez: un test que nunca vio el caso que dice prevenir no ha demostrado que lo previene.\n\n## reproducir-lo-que-el-cliente-real-envia-no-lo-que-uno-cree-que-envia (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1894","metadata":{"content":"l-envia-no-lo-que-uno-cree-que-envia (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1895","metadata":{"content":"-envia-no-lo-que-uno-cree-que-envia (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1896","metadata":{"content":"envia-no-lo-que-uno-cree-que-envia (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1897","metadata":{"content":"nvia-no-lo-que-uno-cree-que-envia (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1898","metadata":{"content":"via-no-lo-que-uno-cree-que-envia (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1899","metadata":{"content":"ia-no-lo-que-uno-cree-que-envia (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#19","metadata":{"content":"tension-de-diseno-en-la-spec (SPEC)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#190","metadata":{"content":"lo-no-es-check (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1900","metadata":{"content":"a-no-lo-que-uno-cree-que-envia (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.md#1901","metadata":{"content":"-no-lo-que-uno-cree-que-envia (VERIFICAR)","okf_concept":"casos-reales.md","okf_type":"Concept","title":"Casos reales de la metodología"}},{"id":"casos-reales.