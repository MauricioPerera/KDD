{
  "description": "Optional, non-blocking KDD lifecycle events. Review and trust before enabling.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/scripts/kdd-event-relay.py",
            "command_windows": "py -3 ${PLUGIN_ROOT}\\scripts\\kdd-event-relay.py",
            "async": true,
            "timeout": 10,
            "statusMessage": "Recording KDD session lifecycle"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/scripts/kdd-event-relay.py",
            "command_windows": "py -3 ${PLUGIN_ROOT}\\scripts\\kdd-event-relay.py",
            "async": true,
            "timeout": 10,
            "statusMessage": "Recording KDD turn completion"
          }
        ]
      }
    ]
  }
}
